# Apache: закрываем от скачивания файл с токеном и служебные файлы.
# Если у вас Nginx, добавьте в конфиг сервера:  location ~ /(config\.php|config\.example\.php)$ { deny all; }
<FilesMatch "^(config(\.example)?\.php|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
